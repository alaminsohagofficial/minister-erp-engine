# =====================================================================
# BRAC BANK CORPORATE API CONFIGURATION
# =====================================================================

# ব্র্যাক ব্যাংকের এপিআই বেস ইউআরএল (টেস্টিংয়ের জন্য Sandbox / লাইভের জন্য Production URL)
BRAC_API_BASE_URL=https://api-sandbox.bracbank.com/v1

# ব্র্যাক ব্যাংক থেকে দেওয়া Client ID এবং Client Secret
BRAC_CLIENT_ID=your_brac_client_id_here
BRAC_CLIENT_SECRET=your_brac_client_secret_here

# ট্রান্সফার চ্যানেল (NPSB / BEFTN / RTGS / INTRABANK)
BRAC_DEFAULT_CHANNEL=NPSB

# =====================================================================
# SYSTEM & DATABASE SETTINGS
# =====================================================================
DB_NAME=minister_main_system.db
ENVIRONMENT=development

# =====================================================================
# GOOGLE GEMINI AI CONFIGURATION (ঐচ্ছিক)
# =====================================================================
GEMINI_API_KEY=your_gemini_api_key_here
